{
  "name": "web-search-router",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "description": "Priority-based, self-healing web search router with a Firecrawl-compatible API.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zbejas/web-search-router.git"
  },
